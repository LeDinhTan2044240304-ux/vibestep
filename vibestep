function qrPaymentM(orderData){
  const orderId = Date.now().toString().slice(-6);
  const fullOrder = {...orderData, id: orderId, status: 'Chờ xác nhận', payment: 'QR Chuyển khoản', d: new Date().toLocaleDateString('vi-VN')};
  
  // Trừ tồn kho sản phẩm
  cart.forEach(x=>{
    const prod = P.find(item=>item.id==x.id);
    if(prod) prod.stock = Math.max(0, prod.stock - x.q);
  });
  LS.s('vibestep_products', P.map(p=>[p.id, p.sku, p.n, p.pr, p.c, p.t.split(' ')[0], p.d, p.stock]));

  LS.s('giay_orders',LS.g('giay_orders',[]).concat(fullOrder));
  cart=[]; save();

  openM(`<h2>Quét mã QR Thanh toán</h2>
  <div style="text-align:center; padding:10px">
    <p>Vui lòng mở App Ngân hàng quét mã VietQR bên dưới:</p>
