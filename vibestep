    <div style="max-height:200px; overflow-y:auto; border:1px solid var(--line); border-radius:10px">
      <table style="width:100%; border-collapse:collapse; font-size:13px">
        <thead><tr style="background:var(--card); border-bottom:1px solid var(--line)"><th style="padding:8px; text-align:left">SKU</th><th style="padding:8px; text-align:left">Tên</th><th style="padding:8px; text-align:left">Giá</th><th style="padding:8px; text-align:left">Kho</th><th style="padding:8px">Thao tác</th></tr></thead>
        <tbody>${productRows}</tbody>
      </table>
    </div>
  </div>

  <div style="margin-bottom:20px">
    <h3>2. Theo dõi & Cập nhật Trạng thái Đơn hàng</h3>
    <div style="max-height:180px; overflow-y:auto">${orderRows}</div>
  </div>

  <div>
    <h3>3. Quản lý Bài viết Hệ thống (Blog / Mẹo)</h3>
    <div style="max-height:150px; overflow-y:auto">${blogRows}</div>
    <button style="margin-top:8px; padding:6px 12px; font-size:12px" data-a="add-blog">+ Thêm bài viết mới</button>
  </div>`);
}

function ordersM(){
  const isAdmin = user.r=='admin';
  const o=LS.g('giay_orders',[]).filter(x=>isAdmin||x.e==user.e).reverse();
  openM(`<h2>${isAdmin?'Quản lý tất cả đơn hàng (Seller)':'Lịch sử đơn hàng của tôi'}</h2>`+(o.length?o.map(x=>`<div class="rw"><div><strong>Đơn #${x.id}</strong> · ${x.d} · Trạng thái: <span style="color:var(--acc)">${x.status||'Chờ xác nhận'}</span><br>${x.name} (${x.ph})<br><small style="color:var(--mut)">${x.ad}</small><br><small>📦 ${x.items}</small></div><strong style="color:var(--acc)">${fm(x.tot)}</strong></div>`).join(''):'<p style="color:var(--mut)">Chưa có đơn hàng nào.</p>'));
}

function guideM(){
  openM(`<h2>Hướng dẫn Đồ án & Tính năng</h2><ol style="padding-left:20px; line-height:1.7"><li><strong>Buyer Flow:</strong> Khách chọn sản phẩm/combo, điền thông tin giao hàng, hệ thống tự động tính phí ship theo khu vực, hỗ trợ thanh toán QR chuyển khoản hoặc COD.</li><li><strong>Seller Flow:</strong> Đăng nhập admin (<b>admin@giay.vn</b> / <b>admin123</b>) để quản lý SKU, cảnh báo tồn kho dưới 2 sản phẩm, cấu hình sản phẩm bán kèm, cập nhật trạng thái đơn hàng và quản lý bài viết hệ thống.</li><li><strong>Thuật toán Apriori:</strong> Tự động gợi ý sản phẩm bán kèm trong giỏ hàng.</li></ol>`);
}

document.addEventListener('click',e=>{
  const b=e.target.closest('[data-a]');
  if(e.target.id=='m')return closeM();
  if(!b)return;
  const a=b.dataset.a,d=b.dataset;
  if(a=='mode'){e.preventDefault();authM(d.m)}
  else if(a=='detail'){
    e.preventDefault();
    if(e.target.closest('select,button,input'))return;
    productM(d.id);
  }
  else if(a=='close')closeM();
  else if(a=='f'){cur=d.k;$('#q').value='';grid();$('#g').scrollIntoView()}
  else if(a=='add'){

    const p=P.find(item=>item.id==d.id),s=hasSize(p)?($('#mc #s'+p.id)||$('#s'+p.id)).value:'';
    if(p.stock <= 0) return toast('Sản phẩm này tạm hết hàng!');
    const k=cart.find(x=>x.id==p.id&&x.s==s);
    k?k.q++:cart.push({id:p.id,s,q:1});
    save();toast('Đã thêm sản phẩm vào giỏ hàng!');
    if(d.re)cartM();
  }
  else if(a=='cart')cartM();
  else if(a=='inc'){cart[d.i].q++;save();cartM()}
  else if(a=='dec'){if(--cart[d.i].q<1)cart.splice(d.i,1);save();cartM()}
  else if(a=='checkout-step')checkoutFormM()
  else if(a=='pay-cod'){
    const data=JSON.parse(d.json);
    const orderId = Date.now().toString().slice(-6);
    const fullOrder = {...data, id: orderId, status: 'Chờ xác nhận', payment: 'COD', d: new Date().toLocaleDateString('vi-VN')};
    
    // Trừ tồn kho
    cart.forEach(x=>{
      const prod = P.find(item=>item.id==x.id);
      if(prod) prod.stock = Math.max(0, prod.stock - x.q);
    });
    LS.s('vibestep_products', P.map(p=>[p.id, p.sku, p.n, p.pr, p.c, p.t.split(' ')[0], p.d, p.stock]));

    LS.s('giay_orders',LS.g('giay_orders',[]).concat(fullOrder));
    cart=[];save();
    openM(`<h2>Đặt hàng thành công 🎉</h2><p>Mã đơn hàng: <b>#${orderId}</b></p><p style="color:var(--mut)">Cảm ơn bạn đã ủng hộ VibeStep! Đơn hàng COD sẽ được giao đến bạn sớm nhất.</p>`);
  }
  else if(a=='pay-qr'){
    const data=JSON.parse(d.json);
    qrPaymentM(data);
  }
  else if(a=='finish-order'){
    openM(`<h2>Thanh toán hoàn tất 🎉</h2><p>Mã đơn hàng: <b>#${d.id}</b> đã được ghi nhận thanh toán qua QR ngân hàng.</p>`);
  }
  else if(a=='user')user?userM():authM('in');
  else if(a=='out'){user=null;LS.s('giay_sess',null);head();closeM()}
  else if(a=='orders')ordersM();
  else if(a=='seller-dashboard')sellerDashboardM();
  else if(a=='guide')guideM();
  else if(a=='pop'){cur='all';$('#q').value=d.q;grid();$('#g').scrollIntoView()}
  else if(a=='edit-stock'){
    const prod = P.find(item=>item.id==d.id);
    const newStock = prompt(`Nhập số lượng tồn kho mới cho [${prod.sku}] ${prod.n}:`, prod.stock);
    if(newStock !== null && !isNaN(newStock)){
      prod.stock = parseInt(newStock);
      LS.s('vibestep_products', P.map(p=>[p.id, p.sku, p.n, p.pr, p.c, p.t.split(' ')[0], p.d, p.stock]));
      toast('Đã cập nhật tồn kho!');
      sellerDashboardM();
      grid();
    }
  }
  else if(a=='update-status'){
    let orders = LS.g('giay_orders',[]);
    const ord = orders.find(o=>o.id==d.id);
    if(ord){
      ord.status = d.st;
      LS.s('giay_orders', orders);
      toast('Đã cập nhật trạng thái đơn hàng!');
      sellerDashboardM();
    }
  }
  else if(a=='add-blog'){
    const title = prompt('Nhập tiêu đề bài viết mới:');
    if(title){
      BLOGS.push({id: Date.now(), title, date: new Date().toLocaleDateString('vi-VN'), content: 'Nội dung bài viết quản trị viên.'});
      LS.s('vibestep_blogs', BLOGS);
      toast('Đã thêm bài viết!');
      sellerDashboardM();
    }
  }
});

document.addEventListener('submit',e=>{
  e.preventDefault();
  const f=e.target,v=Object.fromEntries(new FormData(f));
  if(f.id=='af'){
    const em=v.e.toLowerCase();
    if(f.dataset.mode=='up'){
      if(USERS().some(u=>u.e==em))return authM('up','Email này đã được đăng ký.');
      const u={e:em,p:v.p,n:v.n,r:'user'};LS.s('giay_users',LS.g('giay_users',[]).concat(u));user=u;
   
}
    else{
      const u=USERS().find(u=>u.e==em&&u.p==v.p);
      if(!u)return authM('in','Sai email hoặc mật khẩu.');user=u;
    }
    LS.s('giay_sess',user);head();toast('Xin chào, '+user.n+'!');closeM();
  }else if(f.id=='cf'){
    let subtotal = cart.reduce((a,x)=>{const p=P.find(item=>item.id==x.id); return a+p.pr*x.q;},0);
    let shipFee = v.city == 'hcm' ? 25000 : 40000;
    let tot = subtotal + shipFee;
    let itemsStr = cart.map(x=>{const p=P.find(item=>item.id==x.id); return p.n+(x.s?' ('+x.s+')':'')+' ×'+x.q;}).join('; ');
    
    const orderData = {
      e: user.e,
      name: v.name,
      ph: v.ph,
      ad: v.ad + ` (${v.city == 'hcm' ? 'TP.HCM' : 'Tỉnh khác'})`,
      items: itemsStr,
      subtotal: subtotal,
      shipFee: shipFee,
      tot: tot
    };
    paymentMethodM(orderData);
  }
});

$('#q').addEventListener('input',()=>{cur='all';grid()});
$('#kw').innerHTML=POP.map(k=>`<option value="${k}">`).join('');
$('#pop').innerHTML=POP.pop ? POP.map(k=>`<button data-a="pop" data-q="${k}">${k}</button>`).join('') : '';
head();grid();

</script>
</body>
</html>
