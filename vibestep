function relatedOf(p){
  let ids=[];
  if(p.c=='shoe') ids=[10,11,16].concat(P.filter(x=>x.c=='shoe'&&x.id!=p.id).slice(0,3).map(x=>x.id));
  else if(p.c=='care') ids=[21,22].concat(P.filter(x=>x.c=='shoe').slice(0,2).map(x=>x.id));
  else if(p.c=='acc') ids=[1,7,10].concat(P.filter(x=>x.c=='acc'&&x.id!=p.id).slice(0,2).map(x=>x.id));
  else ids=[1,10,11,21];
  return [...new Set(ids)].filter(i=>i!=p.id).map(i=>P.find(x=>x.id==i)).filter(Boolean).slice(0,4);
}

